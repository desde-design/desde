node_modules/
# Anchored to the package root only — an unanchored `dist/` also matches
# `__tests__/fixtures/fake-payload/dist/`, which IS a tracked test fixture
# (child.test.ts spawns it as a fake payload), not build output.
/dist/
# No trailing slash, deliberately: `git check-ignore -q <path>` (used by
# build-server-package.mts's ensureSafeDestination to decide whether a
# --out INSIDE the repo is safe to write to) treats a bare path with no
# trailing slash as possibly-a-file, and a directory-only pattern
# (`.payload-cache/`) does NOT match it — MEASURED: `git check-ignore -v
# desktop/.payload-cache` reported "not ignored" while the identical path
# WITH a trailing slash reported ignored, using the exact same pattern.
# main.ts always resolves this path via node:path (which never appends a
# trailing slash), so the directory-only form silently defeated the one
# check that exists to keep a 300MB+ payload out of `git status`.
.payload-cache
# Same trailing-slash trap as .payload-cache above, and the same fix: no
# trailing slash, so `git check-ignore -q` (build-server-package.mts's
# ensureSafeDestination, reused as-is by build-desktop-app.mts for the
# per-arch staging dir this holds) sees it as ignored regardless of whether
# the path being checked is a file or a directory.
.package-payload
# electron-builder's own output directory (directories.output in
# electron-builder.config.mjs) — the packaged .app/.dmg/.zip and its
# package-manifest.json. Same reasoning as .payload-cache: large,
# machine-specific, regenerated by `npm run package:desktop`.
release
# A superseded signed build parked out of `release/`'s way; see its README.
.signed-keep
*.tsbuildinfo
# Generated by scripts/generate-notices.mjs at every electron-builder.config.mjs
# evaluation that has a real payload dir (see that config's `noticesEnabled`
# doc comment) — an aggregated snapshot of installed dependency versions'
# license text, not source; regenerated on every real package build, never
# committed.
build/THIRD-PARTY-NOTICES.txt
