# ───────────────────────────────────────────────────────────────────────────
# Root environment. Copy to `.env.local` (gitignored).
#
# This file used to configure the Next.js web app against cloud Firebase and
# five Cloud Run services. None of that exists any more:
#
#   - the GCP stack (Cloud Run / Cloud Build / GCS / Firestore) was removed
#     2026-07-31; the viewer is now the self-hostable Node process in `viewer/`
#   - the Firebase auth surface was removed 2026-08-08 (its token reached
#     nothing — see tasks/todo.md)
#
# So the variables below are the model-provider keys, and nothing else here is
# read by anything. If you are looking for viewer configuration, it is
# `viewer/.env.example`, not this file.
# ───────────────────────────────────────────────────────────────────────────

# Anthropic API key for the Editor's chat and AI edit lanes. Server-side only —
# do NOT add a NEXT_PUBLIC_ prefix.
#
# OPTIONAL, like every key here: set the one for the provider you use. Desde
# picks the first provider it has a key for, in the order anthropic, openai,
# unless `llm.defaultProvider` in `.desde/config.json` says otherwise. Override
# the variable NAME per-prototype via `llm.providers.<id>.apiKeyEnv` there.
ANTHROPIC_API_KEY=

# OpenAI API key for the same features. Server-side only.
OPENAI_API_KEY=

# Point OpenAI requests at another address that speaks the same API (a gateway
# you host, a compatible vendor). Leave unset for OpenAI itself.
OPENAI_BASE_URL=
