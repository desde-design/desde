{
  "name": "@desde/editor-cli",
  "version": "0.1.0-d0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Editor CLI core (D-0 milestone). Boots a Vite supervisor against the user's repo, serves the editor UI bundle, dispatches edits to source files.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "desde": "./bin/desde.mjs",
    "desde-mcp": "./bin/desde-mcp.mjs"
  },
  "main": "./src/core.ts",
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "node scripts/build-server.mjs",
    "build:ui": "vite build --config ui-src/vite.config.ts",
    "dev": "tsx src/cli.ts",
    "start": "node bin/desde.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@babel/parser": "^7.29.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vue/compiler-sfc": "^3.5.33",
    "playwright": "^1.59.1",
    "tailwind-merge": "^3.5.0",
    "vite": "^8.0.0",
    "vite-plugin-vue-tracer": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@vitejs/plugin-react": "^5.1.4",
    "esbuild": "^0.27.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.2",
    "typescript": "^7",
    "vitest": "^4.0.18"
  }
}
