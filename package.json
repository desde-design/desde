{
  "name": "desde",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev:testapp": "cd ai-gateway-prototype && npx vite --port 5188",
    "build:bridge": "esbuild src/bridge/comment-bridge.ts --bundle --outfile=dist/bridge-bundle.js --format=iife --target=es2020 --minify",
    "build:editor": "npm --prefix editor-cli run build",
    "build:all": "npm run build:bridge && npm run build:editor",
    "editor": "npm run build:all && node editor-cli/bin/desde.mjs",
    "editor:self-host": "npm run build:all && node editor-cli/bin/desde.mjs editor-cli/self-host",
    "build:payload": "tsx scripts/build-server-package.mts",
    "build:desktop": "npm --prefix desktop run build",
    "desktop": "npm run build:desktop && desktop/node_modules/.bin/electron desktop",
    "package:desktop": "tsx scripts/build-desktop-app.mts",
    "gallery": "editor-cli/node_modules/.bin/vite --config editor-cli/self-host/vite.config.ts --port 5273 --strictPort",
    "gallery:viewer": "node_modules/.bin/vite --config viewer/gallery/vite.config.ts",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsx scripts/verify.mts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.259",
    "@anthropic-ai/sdk": "^0.95.0",
    "@assistant-ui/react": "^0.14.11",
    "@assistant-ui/react-markdown": "^0.14.1",
    "@assistant-ui/react-syntax-highlighter": "^0.14.1",
    "@babel/parser": "^7.29.3",
    "@babel/types": "^7.29.7",
    "@bramus/specificity": "^2.4.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@dagrejs/dagre": "^2.0.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@uiw/react-codemirror": "^4.25.10",
    "@vue/compiler-dom": "^3.5.40",
    "@vue/compiler-sfc": "^3.5.40",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.25",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-syntax-highlighter": "^16.1.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "undici": "^7.29.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "depcheck": "^1.4.7",
    "esbuild": "^0.27.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "jsdom": "^28.1.0",
    "knip": "^6.30.0",
    "shadcn": "^4.19.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^7.3.2",
    "vitest": "^4.0.18",
    "vue": "^3.5.33",
    "vue-component-meta": "^3.2.7"
  }
}
